# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Primary store. Use a PostgreSQL URL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/antarctic_ops
# Defaults to a local SQLite file so the prototype runs with zero setup.
DATABASE_URL=sqlite:///./data/antarctic_ops.db

# --- NCPOR live environment collector ---
NCPOR_MAITRI_URL=https://data.ncpor.res.in/maitri/live
NCPOR_BHARATI_URL=https://data.ncpor.res.in/bharati/live
NCPOR_REFRESH_INTERVAL=600
NCPOR_REQUEST_TIMEOUT=15

# --- Safe Operating Capacity thresholds ---
WIND_SPEED_LIMIT_KNOTS=35
TEMP_LOW_LIMIT_C=-35
TEMP_HIGH_LIMIT_C=5
CRITICAL_LOAD_MARGIN_KW=50
FUEL_SAFETY_RESERVE_PERCENT=40
FUEL_WARNING_BUFFER_PERCENT=10
